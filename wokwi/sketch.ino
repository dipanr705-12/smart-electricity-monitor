/*
 * ============================================================
 *  SMART ELECTRICITY MONITOR — WOKWI SIMULATION VERSION
 * ============================================================
 *  Differences from real hardware:
 *   • PZEM-004T is SIMULATED — readings generated by firmware
 *   • Slide potentiometer (GPIO34) controls simulated load (0–5000 W)
 *   • Blue button  (GPIO13) = Reset energy counter
 *   • Green button (GPIO14) = Cycle OLED display page manually
 *   • Green LED (GPIO2)     = Heartbeat (blinks every publish)
 *   • Red LED   (GPIO4)     = Alert (lights when power > threshold)
 *   • MQTT removed (Wokwi has no real network — output via Serial)
 * ============================================================
 *  Libraries needed in Wokwi (libraries.txt):
 *    Adafruit SSD1306
 *    Adafruit GFX Library
 *    ArduinoJson
 * ============================================================
 */

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <ArduinoJson.h>
#include <math.h>

// ── OLED ──────────────────────────────────────────────
#define OLED_WIDTH   128
#define OLED_HEIGHT   64
#define OLED_ADDR    0x3C
Adafruit_SSD1306 oled(OLED_WIDTH, OLED_HEIGHT, &Wire, -1);

// ── Pins ──────────────────────────────────────────────
#define PIN_STATUS_LED  2    // green heartbeat LED
#define PIN_ALERT_LED   4    // red alert LED
#define PIN_BTN_RESET   13   // reset energy counter
#define PIN_BTN_PAGE    14   // manually advance OLED page
#define PIN_POT_LOAD    34   // analog – simulate load power

// ── Thresholds ────────────────────────────────────────
#define POWER_ALERT_W    2000.0f
#define ENERGY_ALERT_KWH 10.0f
#define NOMINAL_VOLTAGE  230.0f
#define NOMINAL_FREQ     50.0f
#define TARIFF_PER_KWH   8.0f   // ₹/kWh

// ── Intervals (ms) ────────────────────────────────────
#define SAMPLE_MS    1000
#define PUBLISH_MS   3000
#define DISPLAY_MS   3000

// ── Simulated readings ────────────────────────────────
struct Readings {
  float voltage     = 230.0f;
  float current     = 0.0f;
  float power       = 0.0f;
  float energy      = 0.0f;   // kWh accumulated
  float frequency   = 50.0f;
  float powerFactor = 0.95f;
};

Readings r;

// ── State ─────────────────────────────────────────────
float    energyAccumKWh = 0.0f;
bool     powerAlertSent  = false;
bool     energyAlertSent = false;
uint8_t  displayPage     = 0;
unsigned long lastSample  = 0;
unsigned long lastPublish = 0;
unsigned long lastDisplay = 0;
unsigned long simStartMs  = 0;

// Button debounce
bool     lastResetState   = HIGH;
bool     lastPageState    = HIGH;

// ── Helpers ───────────────────────────────────────────
float readLoadWatts() {
  // Pot 0–4095 → 0–5000 W with a little sinusoidal ripple
  int raw = analogRead(PIN_POT_LOAD);
  float base = (raw / 4095.0f) * 5000.0f;
  // small ±3% ripple to make it look live
  float ripple = base * 0.03f * sinf(millis() / 2000.0f);
  return max(0.0f, base + ripple);
}

void simulateReadings() {
  float load = readLoadWatts();

  // Voltage sags slightly under load
  r.voltage = NOMINAL_VOLTAGE - (load / 5000.0f) * 4.0f
              + 0.5f * sinf(millis() / 3000.0f);

  // Power factor: good at low load, dips at high
  r.powerFactor = 0.98f - (load / 5000.0f) * 0.15f;
  r.powerFactor = constrain(r.powerFactor, 0.70f, 0.99f);

  r.power   = load;
  r.current = (r.voltage > 0) ? (r.power / (r.voltage * r.powerFactor)) : 0;

  // Frequency: tiny drift
  r.frequency = NOMINAL_FREQ + 0.05f * sinf(millis() / 7000.0f);

  // Accumulate energy: P(W) × Δt(h) → kWh
  float dtHours = SAMPLE_MS / 3600000.0f;
  energyAccumKWh += (r.power * dtHours) / 1000.0f;
  r.energy = energyAccumKWh;
}

void publishSerial() {
  StaticJsonDocument<256> doc;
  doc["voltage"]      = round(r.voltage * 10) / 10.0;
  doc["current"]      = round(r.current * 1000) / 1000.0;
  doc["power"]        = round(r.power * 10) / 10.0;
  doc["energy_kwh"]   = round(r.energy * 10000) / 10000.0;
  doc["frequency"]    = round(r.frequency * 10) / 10.0;
  doc["power_factor"] = round(r.powerFactor * 100) / 100.0;
  doc["est_cost_inr"] = round(r.energy * TARIFF_PER_KWH * 100) / 100.0;

  String out;
  serializeJson(doc, out);
  Serial.println("[MQTT→home/energy/data] " + out);
}

void checkAlerts() {
  if (r.power > POWER_ALERT_W && !powerAlertSent) {
    powerAlertSent = true;
    Serial.printf("\n⚠️  ALERT: Power %.1f W exceeds %.0f W threshold!\n\n",
                  r.power, POWER_ALERT_W);
    digitalWrite(PIN_ALERT_LED, HIGH);
  } else if (r.power <= POWER_ALERT_W) {
    powerAlertSent = false;
    if (!energyAlertSent) digitalWrite(PIN_ALERT_LED, LOW);
  }

  if (r.energy > ENERGY_ALERT_KWH && !energyAlertSent) {
    energyAlertSent = true;
    Serial.printf("\n⚠️  ALERT: Energy %.4f kWh exceeds %.1f kWh threshold!\n\n",
                  r.energy, ENERGY_ALERT_KWH);
    digitalWrite(PIN_ALERT_LED, HIGH);
  }
}

// ── OLED pages ────────────────────────────────────────
void drawPage0() {
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("--- Voltage / Current ---");

  oled.setTextSize(2);
  oled.setCursor(0, 14);
  oled.printf("%.1f V", r.voltage);

  oled.setTextSize(2);
  oled.setCursor(0, 36);
  oled.printf("%.2f A", r.current);
}

void drawPage1() {
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("--- Power / Energy ---");

  oled.setTextSize(2);
  oled.setCursor(0, 14);
  oled.printf("%.0f W", r.power);

  oled.setTextSize(1);
  oled.setCursor(0, 36);
  oled.printf("Energy : %.4f kWh", r.energy);
  oled.setCursor(0, 48);
  oled.printf("Cost   : Rs%.2f", r.energy * TARIFF_PER_KWH);

  // Mini bargraph for power
  int barW = (int)((r.power / 5000.0f) * 100);
  barW = constrain(barW, 0, 100);
  oled.drawRect(0, 58, 102, 5, SSD1306_WHITE);
  oled.fillRect(1, 59, barW, 3, SSD1306_WHITE);
  oled.setCursor(104, 56);
  oled.setTextSize(1);
  oled.printf("%3d%%", (int)(r.power / 5000.0f * 100));
}

void drawPage2() {
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("--- Line Quality ---");

  oled.setCursor(0, 14);
  oled.printf("Freq : %.2f Hz", r.frequency);
  oled.setCursor(0, 26);
  oled.printf("PF   : %.3f", r.powerFactor);

  // PF quality indicator
  String pfLabel;
  if (r.powerFactor >= 0.95f)      pfLabel = "(Excellent)";
  else if (r.powerFactor >= 0.85f) pfLabel = "(Good)";
  else if (r.powerFactor >= 0.75f) pfLabel = "(Fair)";
  else                              pfLabel = "(Poor)";
  oled.setCursor(0, 38);
  oled.print(pfLabel);

  oled.setCursor(0, 50);
  oled.print("Mode : SIMULATION");
}

void drawPage3() {
  // Summary / stats page
  oled.setTextSize(1);
  oled.setCursor(0, 0);
  oled.print("--- Summary ---");

  unsigned long upSec = (millis() - simStartMs) / 1000;
  oled.setCursor(0, 12);
  oled.printf("Uptime: %02lu:%02lu:%02lu",
              upSec / 3600, (upSec % 3600) / 60, upSec % 60);
  oled.setCursor(0, 24);
  oled.printf("Voltage : %.1f V", r.voltage);
  oled.setCursor(0, 36);
  oled.printf("Power   : %.1f W", r.power);
  oled.setCursor(0, 48);
  oled.printf("Energy  : %.4f kWh", r.energy);

  // Alert indicator
  oled.setCursor(90, 0);
  if (r.power > POWER_ALERT_W || r.energy > ENERGY_ALERT_KWH) {
    oled.print("!ALT");
  } else {
    oled.print(" OK ");
  }
}

void updateDisplay() {
  oled.clearDisplay();
  switch (displayPage % 4) {
    case 0: drawPage0(); break;
    case 1: drawPage1(); break;
    case 2: drawPage2(); break;
    case 3: drawPage3(); break;
  }
  // Page indicator dots at bottom right
  for (int i = 0; i < 4; i++) {
    if (i == displayPage % 4)
      oled.fillCircle(110 + i * 5, 62, 2, SSD1306_WHITE);
    else
      oled.drawCircle(110 + i * 5, 62, 2, SSD1306_WHITE);
  }
  oled.display();
}

// ── Setup ─────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  Serial.println("\n========================================");
  Serial.println("  Smart Electricity Monitor — Wokwi Sim");
  Serial.println("========================================");
  Serial.println("Slide potentiometer to vary simulated load.");
  Serial.println("Blue  button = Reset energy counter");
  Serial.println("Green button = Next OLED page");
  Serial.println("----------------------------------------\n");

  pinMode(PIN_STATUS_LED, OUTPUT);
  pinMode(PIN_ALERT_LED,  OUTPUT);
  pinMode(PIN_BTN_RESET,  INPUT_PULLUP);
  pinMode(PIN_BTN_PAGE,   INPUT_PULLUP);
  analogReadResolution(12);

  if (!oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println("OLED init failed!");
    while (true);
  }
  oled.clearDisplay();
  oled.setTextColor(SSD1306_WHITE);

  // Splash
  oled.setTextSize(1);
  oled.setCursor(8, 10);  oled.print("Smart Energy Monitor");
  oled.setCursor(20, 24); oled.print("Wokwi Simulation");
  oled.setCursor(30, 38); oled.print("Initialising...");
  oled.display();
  delay(1500);

  simStartMs = millis();
  Serial.println("[SIM] Simulation started. Adjust pot for load.\n");
}

// ── Loop ──────────────────────────────────────────────
void loop() {
  unsigned long now = millis();

  // ── Button: Reset energy ──
  bool resetNow = digitalRead(PIN_BTN_RESET);
  if (lastResetState == HIGH && resetNow == LOW) {
    energyAccumKWh  = 0.0f;
    energyAlertSent = false;
    if (!powerAlertSent) digitalWrite(PIN_ALERT_LED, LOW);
    Serial.println("[CMD] Energy counter RESET.");
  }
  lastResetState = resetNow;

  // ── Button: Next OLED page ──
  bool pageNow = digitalRead(PIN_BTN_PAGE);
  if (lastPageState == HIGH && pageNow == LOW) {
    displayPage = (displayPage + 1) % 4;
    updateDisplay();
  }
  lastPageState = pageNow;

  // ── Sample readings ──
  if (now - lastSample >= SAMPLE_MS) {
    lastSample = now;
    simulateReadings();
    checkAlerts();
  }

  // ── Publish to Serial (MQTT substitute) ──
  if (now - lastPublish >= PUBLISH_MS) {
    lastPublish = now;
    publishSerial();
    // Heartbeat blink
    digitalWrite(PIN_STATUS_LED, HIGH);
    delay(80);
    digitalWrite(PIN_STATUS_LED, LOW);
  }

  // ── Rotate OLED pages ──
  if (now - lastDisplay >= DISPLAY_MS) {
    lastDisplay = now;
    displayPage = (displayPage + 1) % 4;
    updateDisplay();
  }
}
