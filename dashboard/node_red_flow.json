[
  {
    "id": "tab_1",
    "type": "tab",
    "label": "Energy Monitor",
    "disabled": false,
    "info": "Smart Electricity Monitor – Node-RED Dashboard"
  },
  {
    "id": "mqtt_in_data",
    "type": "mqtt in",
    "name": "Energy Data",
    "topic": "home/energy/data",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "wires": [["parse_json"]]
  },
  {
    "id": "mqtt_in_alert",
    "type": "mqtt in",
    "name": "Alerts",
    "topic": "home/energy/alert",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "wires": [["alert_notify"]]
  },
  {
    "id": "mqtt_out_reset",
    "type": "mqtt out",
    "name": "Reset Energy",
    "topic": "home/energy/reset",
    "qos": "0",
    "retain": false,
    "broker": "mqtt_broker"
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Local Broker",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-energy",
    "usetls": false,
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "parse_json",
    "type": "function",
    "name": "Route Readings",
    "func": "var v = msg.payload;\nmsg.voltage     = { payload: v.voltage,      topic: 'Voltage (V)' };\nmsg.current     = { payload: v.current,      topic: 'Current (A)' };\nmsg.power       = { payload: v.power,        topic: 'Power (W)'   };\nmsg.energy      = { payload: v.energy_kwh,   topic: 'Energy (kWh)'};\nmsg.pf          = { payload: v.power_factor, topic: 'Power Factor'};\nmsg.cost        = { payload: v.est_cost_inr, topic: 'Est. Cost (₹)'};\nreturn [msg.voltage, msg.current, msg.power, msg.energy, msg.pf, msg.cost];",
    "outputs": 6,
    "wires": [
      ["gauge_voltage"],
      ["gauge_current"],
      ["gauge_power"],
      ["chart_energy", "text_energy"],
      ["gauge_pf"],
      ["text_cost"]
    ]
  },
  {
    "id": "gauge_voltage",
    "type": "ui_gauge",
    "name": "Voltage",
    "group": "group_live",
    "order": 1,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Voltage",
    "label": "V",
    "format": "{{value}} V",
    "min": 180,
    "max": 260,
    "seg1": 210,
    "seg2": 240,
    "diff": false,
    "className": ""
  },
  {
    "id": "gauge_current",
    "type": "ui_gauge",
    "name": "Current",
    "group": "group_live",
    "order": 2,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Current",
    "label": "A",
    "format": "{{value}} A",
    "min": 0,
    "max": 20,
    "seg1": 10,
    "seg2": 16,
    "diff": false
  },
  {
    "id": "gauge_power",
    "type": "ui_gauge",
    "name": "Power",
    "group": "group_live",
    "order": 3,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Power",
    "label": "W",
    "format": "{{value}} W",
    "min": 0,
    "max": 5000,
    "seg1": 2000,
    "seg2": 3500,
    "diff": false
  },
  {
    "id": "gauge_pf",
    "type": "ui_gauge",
    "name": "Power Factor",
    "group": "group_live",
    "order": 4,
    "width": 3,
    "height": 3,
    "gtype": "gage",
    "title": "Power Factor",
    "label": "",
    "format": "{{value}}",
    "min": 0,
    "max": 1,
    "seg1": 0.6,
    "seg2": 0.8,
    "diff": false
  },
  {
    "id": "chart_energy",
    "type": "ui_chart",
    "name": "Energy History",
    "group": "group_history",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Energy Consumption (kWh)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm",
    "interpolate": "linear",
    "nodata": "No data yet",
    "ymin": "",
    "ymax": "",
    "removeOlder": 1,
    "removeOlderPoints": "",
    "removeOlderUnit": "86400",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#1565c0", "#E6E0F8", "#ff7f0e"]
  },
  {
    "id": "text_energy",
    "type": "ui_text",
    "name": "Energy Text",
    "group": "group_totals",
    "order": 1,
    "width": 4,
    "height": 2,
    "title": "Total Energy",
    "format": "{{msg.payload}} kWh",
    "layout": "row-spread"
  },
  {
    "id": "text_cost",
    "type": "ui_text",
    "name": "Cost Text",
    "group": "group_totals",
    "order": 2,
    "width": 4,
    "height": 2,
    "title": "Est. Cost",
    "format": "₹{{msg.payload}}",
    "layout": "row-spread"
  },
  {
    "id": "alert_notify",
    "type": "ui_toast",
    "name": "Alert Toast",
    "position": "top right",
    "displayTime": "5",
    "highlight": "",
    "sendall": true,
    "outputs": 0,
    "ok": "OK",
    "cancel": "",
    "raw": false,
    "topic": "",
    "className": ""
  },
  {
    "id": "group_live",
    "type": "ui_group",
    "name": "Live Readings",
    "tab": "tab_1",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "group_history",
    "type": "ui_group",
    "name": "Energy History",
    "tab": "tab_1",
    "order": 2,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "group_totals",
    "type": "ui_group",
    "name": "Totals & Cost",
    "tab": "tab_1",
    "order": 3,
    "disp": true,
    "width": "12",
    "collapse": false
  }
]
